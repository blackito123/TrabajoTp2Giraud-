{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "includeFiles": "{src/routes/**/*.js,src/models/**/*.js,node_modules/swagger-ui-dist/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api-docs/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api-docs",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
